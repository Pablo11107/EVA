# Configuración de EVA en servidor propio. Copiar a «.env» y rellenar.
#
#   cp .env.ejemplo .env && chmod 600 .env && scripts/generar-secretos.sh
#
# El archivo .env contiene secretos: no se sube a ningún repositorio y solo
# lo lee el administrador del servidor (permisos 600). Si se filtra, rotar
# POSTGRES_PASSWORD; ENCRYPTION_SECRET no se puede rotar sin perder las
# credenciales guardadas en el editor (EVA no guarda ninguna).

# ── Dominios ─────────────────────────────────────────────────────────────────
# Dos nombres distintos, obligatoriamente: el visor y el editor comparten
# cookies si van en el mismo nombre con distinto puerto. Los dos deben
# resolver a este servidor (DNS) para que Caddy obtenga el certificado.
EVA_DOMINIO_VISOR=asistente.emalsa.es
EVA_DOMINIO_EDITOR=eva-editor.emalsa.es

# Identificador público del bot, el que se pone en «Share» al publicarlo en
# el editor. Caddy solo deja pasar peticiones de la web para este bot.
EVA_PUBLIC_ID=eva

# Correo que recibe los avisos de caducidad del certificado TLS.
EVA_CORREO_TLS=informatica@emalsa.es

# ── Typebot: obligatorio ─────────────────────────────────────────────────────
# Clave de 32 caracteres con la que Typebot cifra datos sensibles. Debe ser la
# misma en editor y visor (aquí lo es: comparten este archivo). La genera
# scripts/generar-secretos.sh.
ENCRYPTION_SECRET=

# Contraseña de PostgreSQL. Debe aparecer igual en las dos líneas siguientes
# (el script la escribe en ambas).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:CAMBIAR@typebot-db:5432/typebot

# URL pública del editor y del visor (con https://, sin barra final).
NEXTAUTH_URL=https://eva-editor.emalsa.es
NEXT_PUBLIC_VIEWER_URL=https://asistente.emalsa.es

NODE_OPTIONS=--no-node-snapshot

# ── Cuentas ──────────────────────────────────────────────────────────────────
# Nadie puede registrarse por su cuenta: solo entran las personas invitadas
# desde el editor por un administrador.
DISABLE_SIGNUP=true

# Correo del primer administrador (plan ilimitado, sin cupo de conversaciones).
# Varios: separados por comas, sin espacios.
ADMIN_EMAIL=informatica@emalsa.es

# Plan de los espacios de trabajo que se creen después. En servidor propio
# los planes solo son cupos artificiales: UNLIMITED los quita.
DEFAULT_WORKSPACE_PLAN=UNLIMITED

# ── Correo saliente: el inicio de sesión funciona con un código por correo ──
# Sin contraseñas: Typebot envía un código de un solo uso al correo invitado.
# Datos del servidor de correo de la empresa (preguntar a sistemas).
SMTP_HOST=smtp.emalsa.es
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=eva@emalsa.es
SMTP_PASSWORD=
NEXT_PUBLIC_SMTP_FROM='EVA (editor) <eva@emalsa.es>'
# Si el servidor de correo está en la red interna (10.x, 172.16-31.x,
# 192.168.x), hay que autorizarlo expresamente; si no, Typebot lo bloquea
# como medida anti-SSRF:
# SSRF_ALLOWED_HOSTS=smtp.emalsa.es

# ── Informe mensual ──────────────────────────────────────────────────────────
# Quién recibe el día 1 de cada mes el informe y las estadísticas del mes
# anterior (solo recuentos: sin datos personales). Usa el mismo buzón de
# salida de arriba. Varias direcciones, separadas por comas. Si se deja vacío,
# no se envía nada y el informe se queda en informes/.
# Provisionalmente, la persona que mantiene el contenido (la dirección se
# entrega aparte, no se publica en el repositorio).
EVA_INFORME_PARA=
# Remitente del informe; si se deja comentado, el de NEXT_PUBLIC_SMTP_FROM.
# EVA_INFORME_DE='EVA (informe mensual) <eva@emalsa.es>'

# ── Alternativa: entrar con la cuenta corporativa de Microsoft 365 ──────────
# Requiere registrar una aplicación en Entra ID (Azure AD) con la URL de
# retorno https://<EVA_DOMINIO_EDITOR>/api/auth/callback/azure-ad
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# Y, si se quiere que solo se entre con Microsoft:
# SMTP_AUTH_DISABLED=true

# ── Lo que EVA no usa, y por tanto queda apagado ─────────────────────────────
# Sin S3 (no hay subida de archivos ni imágenes), sin WhatsApp, sin Google
# Sheets, sin webhooks (WEBHOOK_RELAY_SECRET sin definir: los bloques Webhook
# no funcionan, y el verificador del repositorio tampoco los admite), sin
# telemetría (PostHog, Sentry) ni avisos a terceros.
